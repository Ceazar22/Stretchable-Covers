<script>
  (() => {
    const modalId = '{{ safe_modal_id }}';
    const modal = document.getElementById(modalId);

    if (!modal || modal.dataset.initialized === 'true') {
      return;
    }

    modal.dataset.initialized = 'true';

    /*
     * Move the modal directly inside the body.
     * This stops Shopify section borders, rounded corners,
     * transforms and overflow hidden from clipping the overlay.
     */
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    const dialog = modal.querySelector(
      '[data-safe-modal-dialog]'
    );

    const openButtons = document.querySelectorAll(
      `[data-safe-modal-open="${modalId}"]`
    );

    const closeButtons = modal.querySelectorAll(
      '[data-safe-modal-close]'
    );

    let previouslyFocusedElement = null;

    const getFocusableElements = () => {
      return Array.from(
        modal.querySelectorAll(
          'button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );
    };

    const openModal = () => {
      previouslyFocusedElement = document.activeElement;

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');

      document.documentElement.classList.add(
        'custom-cover-safe-modal-open'
      );

      document.body.classList.add(
        'custom-cover-safe-modal-open'
      );

      requestAnimationFrame(() => {
        dialog?.focus();
      });
    };

    const closeModal = () => {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');

      document.documentElement.classList.remove(
        'custom-cover-safe-modal-open'
      );

      document.body.classList.remove(
        'custom-cover-safe-modal-open'
      );

      if (
        previouslyFocusedElement &&
        typeof previouslyFocusedElement.focus === 'function'
      ) {
        previouslyFocusedElement.focus();
      }
    };

    openButtons.forEach((button) => {
      button.addEventListener('click', openModal);
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    modal.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeModal();
        return;
      }

      if (event.key !== 'Tab') {
        return;
      }

      const focusableElements = getFocusableElements();

      if (!focusableElements.length) {
        event.preventDefault();
        dialog?.focus();
        return;
      }

      const firstElement = focusableElements[0];
      const lastElement =
        focusableElements[focusableElements.length - 1];

      if (
        event.shiftKey &&
        document.activeElement === firstElement
      ) {
        event.preventDefault();
        lastElement.focus();
      } else if (
        !event.shiftKey &&
        document.activeElement === lastElement
      ) {
        event.preventDefault();
        firstElement.focus();
      }
    });
  })();
</script>



      
