      width: 100%;
      max-width: 100%;
    }

    .variant-picker .variant-imprint-tabs__list {
      flex-wrap: nowrap;
    }

    .variant-picker .variant-imprint-tab {
      flex: 1 1 0%;
      min-width: 0;
      padding: 5px 3px;
      font-size: 10px;
      line-height: 1.2;
      white-space: nowrap;
    }
  }

  .variant-option--imprint-size .varian-option-container > label {
    flex: 1 1 auto;
    max-width: none;
    padding-right: 0;
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
  }

  .variant-imprint-size__alert {
    margin: 6px 0 0;
    color: #b42318;
    font-family: Lato, sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.3;
  }

  .variant-imprint-size__alert[hidden] {
    display: none;
  }

  .variant-option--imprint-size .variant-imprint-size__select-wrapper--error {
    border-color: #b42318;
  }

  .variant-option--imprint-size--disabled {
    opacity: 0.55;
  }

  .variant-option--imprint-size--disabled .variant-option__select-wrapper {
    pointer-events: none;
    background: #f5f6f8;
  }

  .variant-option--imprint-size--disabled .variant-option__select {
    cursor: not-allowed;
  }

  .variant-picker__form--single-option {
    display: block !important;
    width: 100% !important;
  }

  .variant-picker__form--single-option > .variant-option {
    width: 100% !important;
    max-width: none !important;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }

  @media screen and (max-width: 767px) {
    .variant-option--text-mode {
      gap: 10px !important;
    }

    .variant-option--text-mode .varian-option-container--single {
      flex: 0 0 calc(50% - 5px) !important;
      width: calc(50% - 5px) !important;
      max-width: calc(50% - 5px) !important;
    }

    .variant-option--text-mode .variant-option__text-input-wrapper {
      flex: 0 0 calc(50% - 5px) !important;
      width: calc(50% - 5px) !important;
      max-width: calc(50% - 5px) !important;
    }

    .variant-color-swatch__legend {
      font-size: 16px;
    }

    .variant-color-swatch {
      width: 36px;
      height: 36px;
    }

    .variant-color-swatch__circle {
      width: 32px;
      height: 32px;
    }

    .variant-size-guide-modal {
      padding: 14px;
    }

    .variant-size-guide-modal__dialog {
      max-width: 365px;
      max-height: calc(100vh - 28px);
      border-radius: 8px;
    }

    .variant-size-guide-modal__close {
      top: 12px;
      right: 14px;
      width: 24px;
      height: 24px;
      font-size: 28px;
    }

    .variant-size-guide-modal__content,
    .variant-size-guide-modal__content--printing-note {
      padding: 38px 28px 32px;
    }

    .variant-size-guide-modal__title {
      margin-bottom: 42px;
      font-size: 20px;
      line-height: 27px;
    }

    .variant-size-guide-modal__intro {
      font-size: 16px;
      line-height: 24px;
    }

    .variant-size-guide-modal__body,
    .variant-size-guide-modal__body--printing-note,
    .variant-size-guide-modal__list,
    .variant-size-guide-modal__example {
      font-size: 14px;
      line-height: 18px;
    }

    .variant-size-guide-modal__list {
      padding-left: 20px;
    }

    .variant-size-guide-modal__list li {
      margin-bottom: 8px;
    }
  }
{% endstylesheet %}
