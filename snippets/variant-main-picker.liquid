  </variant-picker>

  <script>
    if (!window.variantColorSwatchesInit) {
      window.variantColorSwatchesInit = true;

      function updateColorSwatchText(fieldset) {
        if (!fieldset) return;

        var selectedText = fieldset.querySelector('[data-color-swatch-selected]');
        var checkedInput = fieldset.querySelector('.variant-color-swatch__input:checked');

        if (selectedText && checkedInput) {
          selectedText.textContent = checkedInput.value;
        }
      }

      function updateAllColorSwatchTexts() {
        document.querySelectorAll('.variant-option--color-swatches').forEach(function(fieldset) {
          updateColorSwatchText(fieldset);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateAllColorSwatchTexts);
      } else {
        updateAllColorSwatchTexts();
      }

      document.addEventListener('shopify:section:load', function () {
        updateAllColorSwatchTexts();
      });

      document.addEventListener('change', function(event) {
        var input = event.target.closest('.variant-color-swatch__input');

        if (!input) return;

        var fieldset = input.closest('.variant-option--color-swatches');
        updateColorSwatchText(fieldset);
      });
    }
  </script>

  <script>
    if (!window.variantSizeGuideModalInit) {
      window.variantSizeGuideModalInit = true;

      function moveModalToBody(modal) {
        if (!modal || modal.dataset.movedToBody === 'true') return;
        document.body.appendChild(modal);
        modal.dataset.movedToBody = 'true';
      }

      function openSizeGuideModal(modal, triggerButton) {
        if (!modal) return;

        moveModalToBody(modal);

        modal.classList.add('is-active');
        modal.setAttribute('aria-hidden', 'false');
        modal._triggerButton = triggerButton || null;
        document.body.classList.add('variant-size-guide-modal-open');

        var closeButton = modal.querySelector('.variant-size-guide-modal__close');
        if (closeButton) {
          closeButton.focus();
        }
      }

      function closeSizeGuideModal(modal) {
        if (!modal) return;

        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');

        if (!document.querySelector('.variant-size-guide-modal.is-active')) {
          document.body.classList.remove('variant-size-guide-modal-open');
        }

        if (modal._triggerButton) {
          modal._triggerButton.focus();
        }
      }

      function prepareAllSizeGuideModals() {
        document.querySelectorAll('.variant-size-guide-modal').forEach(function(modal) {
          moveModalToBody(modal);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', prepareAllSizeGuideModals);
      } else {
        prepareAllSizeGuideModals();
      }

      document.addEventListener('shopify:section:load', function () {
        prepareAllSizeGuideModals();
      });

      document.addEventListener('click', function (event) {
        var openButton = event.target.closest('[data-size-guide-open]');
        if (openButton) {
          event.preventDefault();

          var modalId = openButton.getAttribute('aria-controls');
          var modal = modalId ? document.getElementById(modalId) : null;

          openSizeGuideModal(modal, openButton);
          return;
        }

        var closeButton = event.target.closest('[data-size-guide-close]');
        if (closeButton) {
          event.preventDefault();

          var modal = closeButton.closest('.variant-size-guide-modal');
          closeSizeGuideModal(modal);
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;

        var activeModal = document.querySelector('.variant-size-guide-modal.is-active');
        if (activeModal) {
          closeSizeGuideModal(activeModal);
        }
      });
    }
  </script>

  <script>
    if (!window.customVariantPickerCartFixInit) {
      window.customVariantPickerCartFixInit = true;

      function cleanDiameterValue(value) {
        value = String(value || '')
          .replace(/[^0-9.]/g, '')
          .replace(/(\..*)\./g, '$1')
          .trim();

        return value;
      }

      function escapeCssValue(value) {
        if (window.CSS && typeof window.CSS.escape === 'function') {
          return window.CSS.escape(String(value || ''));
        }

        return String(value || '').replace(/\\/g, '\\\\').replace(/\"/g, '\\\"');
      }

      function findProductFormFromElement(element) {
        var picker = element && element.closest ? element.closest('variant-picker') : null;
        var sectionId = picker ? picker.getAttribute('data-section-id') : null;
        var section;
        var form;

        if (sectionId) {
          section = document.getElementById('shopify-section-' + sectionId);

          if (section) {
            form = section.querySelector('form[action*="/cart/add"]');
            if (form) return form;
          }
        }

        section = element && element.closest
          ? element.closest('section, .shopify-section, [data-section-id], product-info, .product')
          : null;

        if (section) {
          form = section.querySelector('form[action*="/cart/add"]');
          if (form) return form;
        }

        return document.querySelector('form[action*="/cart/add"]');
      }

      function getLinkedDiameterInput(form, input) {
        var key = input && input.id ? input.id : 'custom-diameter';
        var hiddenInput = form.querySelector('input[data-custom-diameter-line-item="' + escapeCssValue(key) + '"]');

        if (!hiddenInput) {
          hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.setAttribute('data-custom-diameter-line-item', key);
          form.appendChild(hiddenInput);
        }

        hiddenInput.name = 'properties[Diameter]';

        return hiddenInput;
      }

      function syncDiameterInput(input) {
        var form;
        var value;
        var hiddenInput;

        if (!input) return '';

        form = findProductFormFromElement(input);
        value = cleanDiameterValue(input.value);

        input.value = value;

        if (!form) return value;

        hiddenInput = getLinkedDiameterInput(form, input);

        if (value && value !== '0') {
          var formattedValue = value;

          if (window.CustomDiameterFormat && typeof window.CustomDiameterFormat.formatDiameterDisplay === 'function') {
            formattedValue = window.CustomDiameterFormat.formatDiameterDisplay(value);
          } else {
            formattedValue = value + "'";
          }

          hiddenInput.value = formattedValue;
          input.dataset.lastValidDiameter = value;
          return formattedValue;
        }

        hiddenInput.remove();
        delete input.dataset.lastValidDiameter;

        return '';
      }

      function syncDiameterInputsInScope(scope) {
        scope = scope || document;

        scope.querySelectorAll('[data-line-item-property-input]').forEach(function(input) {
          syncDiameterInput(input);
        });
      }

      function getPickerVariants(picker) {
        var json = picker ? picker.querySelector('[data-custom-variants-json]') : null;

        if (!json) return [];

        try {
          return JSON.parse(json.textContent || '[]');
        } catch (error) {
          return [];
        }
      }

      function normalizeOption(value) {
        return String(value || '').trim();
      }

      function getImprintSizeOptionIndex(picker) {
        var pickerForm = picker ? picker.querySelector('.variant-picker__form') : null;
        var sizeIndex = -1;

        if (!pickerForm) return sizeIndex;

        Array.prototype.slice.call(pickerForm.children).forEach(function(optionEl, index) {
          if (optionEl.querySelector('[data-imprint-size-select]')) {
            sizeIndex = index;
          }
        });

        return sizeIndex;
      }

      function isImprintSizeDashSelected(select) {
        if (!select) return false;

        var option = select.options[select.selectedIndex];

        return Boolean(option && option.hasAttribute('data-imprint-size-dash'));
      }

      function getPickerOptionValues(picker) {
        var pickerForm = picker ? picker.querySelector('.variant-picker__form') : null;
        var values = [];

        if (!pickerForm) return values;

        Array.prototype.slice.call(pickerForm.children).forEach(function(optionEl, index) {
          var select;
          var checked;
          var selectedOption;

          if (!optionEl.classList || !optionEl.classList.contains('variant-option')) return;

          select = optionEl.querySelector('select');
          checked = optionEl.querySelector('input[type="radio"]:checked');

          if (select) {
            selectedOption = select.options[select.selectedIndex];

            if (selectedOption && selectedOption.hasAttribute('data-imprint-size-dash')) {
              values[index] = undefined;
            } else {
              values[index] = select.value;
            }
          } else if (checked) {
            values[index] = checked.value;
          }
        });

        return values;
      }

      function findMatchingVariant(picker) {
        var variants = getPickerVariants(picker);
        var selectedOptions = getPickerOptionValues(picker);
        var sizeIndex = getImprintSizeOptionIndex(picker);
        var ignoreImprintSize = !imprintTypeRequiresSize(getSelectedImprintType(picker)) && sizeIndex >= 0;

        if (!variants.length || !selectedOptions.length) return null;

        return variants.find(function(variant) {
          if (!variant || !Array.isArray(variant.options)) return false;

          return selectedOptions.every(function(value, index) {
            if (ignoreImprintSize && index === sizeIndex) return true;

            if (value === undefined || value === null || value === '') return true;

            return normalizeOption(variant.options[index]) === normalizeOption(value);
          });
        }) || null;
      }

      function updateSelectedVariantIdForCart(picker) {
        var variant = findMatchingVariant(picker);
        var form = findProductFormFromElement(picker);
        var idInput;

        if (!variant || !variant.id || !form) return '';

        idInput = form.querySelector('[name="id"]');

        if (!idInput) {
          idInput = document.createElement('input');
          idInput.type = 'hidden';
          idInput.name = 'id';
          form.appendChild(idInput);
        }

        idInput.value = variant.id;
        picker.dataset.currentVariantId = variant.id;

        idInput.dispatchEvent(new Event('change', { bubbles: true }));

        return String(variant.id);
      }

      function imprintTypeRequiresSize(imprintType) {
        var value = String(imprintType || '').toLowerCase().trim();

        if (!value || value.indexOf('no imprint') !== -1) return false;

        return value.indexOf('full cover') !== -1 || value.indexOf('standard cover') !== -1;
      }

      function getImprintSizeSelect(picker) {
        return picker ? picker.querySelector('[data-imprint-size-select]') : null;
      }

      function getSelectedImprintType(picker) {
        var input = picker ? picker.querySelector('.variant-imprint-tab input[type="radio"]:checked') : null;

        return input ? input.value : '';
      }

      function ensureImprintSizePlaceholder(select) {
        if (!select) return null;

        var placeholder = select.querySelector('[data-imprint-size-placeholder]');

        if (!placeholder) {
          placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.disabled = true;
          placeholder.setAttribute('data-imprint-size-placeholder', '');
          placeholder.textContent = 'Select imprint size';
          select.insertBefore(placeholder, select.firstChild);
        }

        return placeholder;
      }

      function ensureImprintSizeDashOption(select) {
        if (!select) return null;

        var dashOption = select.querySelector('[data-imprint-size-dash]');

        if (!dashOption) {
          dashOption = document.createElement('option');
          dashOption.value = '-----';
          dashOption.disabled = true;
          dashOption.setAttribute('data-imprint-size-dash', '');
          dashOption.textContent = '-----';
          select.appendChild(dashOption);
        }

        return dashOption;
      }

      function isImprintSizePlaceholderSelected(select) {
        if (!select) return true;

        var option = select.options[select.selectedIndex];

        if (!option) return true;

        if (option.hasAttribute('data-imprint-size-dash')) return false;

        return option.hasAttribute('data-imprint-size-placeholder') || !String(option.value || '').trim();
      }

      function resetImprintSizeToPlaceholder(picker) {
        var select = getImprintSizeSelect(picker);
        var placeholder;

        if (!select) return;

        placeholder = ensureImprintSizePlaceholder(select);
        select.value = '';

        if (placeholder) {
          placeholder.selected = true;
        }
      }

      var IMPRINT_SIZE_ALERT_MESSAGE = 'Please select an imprint size first.';

      function isImprintAddToCartBlocked(picker) {
        if (!getImprintSizeSelect(picker)) return false;

        if (!imprintTypeRequiresSize(getSelectedImprintType(picker))) return false;

        return isImprintSizePlaceholderSelected(getImprintSizeSelect(picker));
      }

      function updateImprintSizeInlineAlert(picker, show) {
        var select = getImprintSizeSelect(picker);
        var optionRow;
        var alertEl;

        if (!select) return;

        optionRow = select.closest('.variant-option--imprint-size');
        if (!optionRow) return;

        alertEl = optionRow.querySelector('[data-imprint-size-alert]');

        if (!alertEl) {
          alertEl = document.createElement('p');
          alertEl.className = 'variant-imprint-size__alert';
          alertEl.setAttribute('data-imprint-size-alert', '');
          alertEl.setAttribute('role', 'alert');
          optionRow.appendChild(alertEl);
        }

        alertEl.textContent = IMPRINT_SIZE_ALERT_MESSAGE;
        alertEl.hidden = !show;

        select
          .closest('.variant-option__select-wrapper')
          ?.classList.toggle('variant-imprint-size__select-wrapper--error', show);
      }

      function notifyImprintSizeRequired(picker) {
        window.alert(IMPRINT_SIZE_ALERT_MESSAGE);

        var sizeSelect = getImprintSizeSelect(picker);
        if (sizeSelect) sizeSelect.focus();

        updateImprintSizeInlineAlert(picker, true);
      }

      function getAddToCartButtonsForPicker(picker) {
        var form = findProductFormFromElement(picker);
        var scope = form
          ? form.closest('section, .shopify-section, [data-section-id], product-info, .product')
          : null;
        var buttons = [];
        var seen = [];

        function addButton(button) {
          if (!button || seen.indexOf(button) !== -1) return;
          seen.push(button);
          buttons.push(button);
        }

        if (form) {
          form
            .querySelectorAll(
              'button[name="add"], [data-add-to-cart], .product-form__submit, add-to-cart-component button[type="submit"]'
            )
            .forEach(addButton);
        }

        if (scope) {
          scope
            .querySelectorAll('sticky-add-to-cart button, .sticky-add-to-cart__button')
            .forEach(addButton);
        }

        return buttons;
      }

      function updateImprintSizeFieldState(picker) {
        var select = getImprintSizeSelect(picker);
        var optionRow;
        var requiresSize = imprintTypeRequiresSize(getSelectedImprintType(picker));

        if (!select) return;

        optionRow = select.closest('.variant-option--imprint-size');

        select.disabled = !requiresSize;

        if (requiresSize) {
          select.removeAttribute('aria-disabled');
        } else {
          select.setAttribute('aria-disabled', 'true');
        }

        if (optionRow) {
          optionRow.classList.toggle('variant-option--imprint-size--disabled', !requiresSize);
        }

        if (!requiresSize) {
          updateImprintSizeInlineAlert(picker, false);
          select
            .closest('.variant-option__select-wrapper')
            ?.classList.remove('variant-imprint-size__select-wrapper--error');
          syncImprintSizeForNonRequiredType(picker);
        }
      }

      function syncImprintSizeForNonRequiredType(picker) {
        var select = getImprintSizeSelect(picker);
        var dashOption;

        if (!select || imprintTypeRequiresSize(getSelectedImprintType(picker))) return;

        dashOption = ensureImprintSizeDashOption(select);
        dashOption.selected = true;
        select.value = '-----';
      }

      function updateImprintAddToCartState(picker) {
        updateImprintSizeFieldState(picker);

        var blocked = isImprintAddToCartBlocked(picker);

        updateImprintSizeInlineAlert(picker, blocked);

        getAddToCartButtonsForPicker(picker).forEach(function(button) {
          if (blocked) {
            button.disabled = true;
            button.setAttribute('aria-disabled', 'true');
            button.dataset.imprintSizeRequired = 'true';
            return;
          }

          if (button.dataset.imprintSizeRequired === 'true') {
            button.disabled = false;
            button.removeAttribute('aria-disabled');
            delete button.dataset.imprintSizeRequired;
          }
        });
      }

      function restoreSavedImprintSize(picker) {
        var select = getImprintSizeSelect(picker);
        var savedSize = picker ? picker.dataset.lastImprintSize : '';
        var option;
        var index;

        if (!select || !savedSize) return false;

        for (index = 0; index < select.options.length; index += 1) {
          option = select.options[index];

          if (
            option.hasAttribute('data-imprint-size-placeholder') ||
            option.hasAttribute('data-imprint-size-dash')
          ) {
            continue;
          }

          if (option.value === savedSize) {
            select.selectedIndex = index;
            return true;
          }
        }

        return false;
      }

      function syncImprintPickerState(picker, options) {
        options = options || {};

        if (!picker || !getImprintSizeSelect(picker)) return;

        ensureImprintSizePlaceholder(getImprintSizeSelect(picker));

        updateImprintSizeFieldState(picker);

        if (imprintTypeRequiresSize(getSelectedImprintType(picker))) {
          if (options.resetSizeToPlaceholder) {
            delete picker.dataset.lastImprintSize;
            resetImprintSizeToPlaceholder(picker);
          } else {
            restoreSavedImprintSize(picker);
          }
        } else {
          syncImprintSizeForNonRequiredType(picker);
        }

        if (!isImprintAddToCartBlocked(picker)) {
          updateSelectedVariantIdForCart(picker);
        }

        updateImprintAddToCartState(picker);
      }

      function refreshImprintAddToCartButtons() {
        document.querySelectorAll('variant-picker').forEach(function(picker) {
          if (!getImprintSizeSelect(picker)) return;
          updateImprintAddToCartState(picker);
        });
      }

      function prepareVariantPicker(picker) {
        if (!picker) return;

        if (picker.dataset.customCartVariantFixReady !== 'true') {
          picker.dataset.customCartVariantFixReady = 'true';

          picker.updateSelectedVariantIdForCart = function() {
            return updateSelectedVariantIdForCart(picker);
          };

          syncImprintPickerState(picker, { resetSizeToPlaceholder: true });
          return;
        }

        updateImprintAddToCartState(picker);
      }

      function prepareAllVariantPickers() {
        document.querySelectorAll('variant-picker').forEach(prepareVariantPicker);
        refreshImprintAddToCartButtons();
      }

      function schedulePrepareAllVariantPickers() {
        prepareAllVariantPickers();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('readystatechange', function onReadyStateChange() {
          if (document.readyState === 'interactive' || document.readyState === 'complete') {
            document.removeEventListener('readystatechange', onReadyStateChange);
            schedulePrepareAllVariantPickers();
          }
        });
        document.addEventListener('DOMContentLoaded', schedulePrepareAllVariantPickers);
        window.addEventListener('load', refreshImprintAddToCartButtons);
      } else {
        schedulePrepareAllVariantPickers();
        refreshImprintAddToCartButtons();
      }

      document.addEventListener('shopify:section:load', function() {
        prepareAllVariantPickers();
        syncDiameterInputsInScope(document);
      });

      document.addEventListener('input', function(event) {
        var input = event.target.closest('[data-number-only-input][data-line-item-property-input]');
        if (!input) return;

        syncDiameterInput(input);
      }, true);

      document.addEventListener('change', function(event) {
        var diameterInput = event.target.closest('[data-number-only-input][data-line-item-property-input]');
        var picker = event.target.closest('variant-picker');
        var imprintTypeInput = event.target.closest('.variant-imprint-tab input[type="radio"]');
        var imprintSizeSelect = event.target.closest('[data-imprint-size-select]');

        if (diameterInput) {
          syncDiameterInput(diameterInput);
        }

        if (!picker) return;

        if (imprintTypeInput) {
          var requiresSize = imprintTypeRequiresSize(imprintTypeInput.value);

          if (requiresSize) {
            delete picker.dataset.lastImprintSize;
          }

          updateImprintAddToCartState(picker);

          syncImprintPickerState(picker, {
            resetSizeToPlaceholder: requiresSize,
          });
          return;
        }

        if (imprintSizeSelect) {
          if (imprintSizeSelect.value) {
            picker.dataset.lastImprintSize = imprintSizeSelect.value;
          } else {
            delete picker.dataset.lastImprintSize;
          }

          syncImprintPickerState(picker);
          return;
        }

        updateSelectedVariantIdForCart(picker);
        updateImprintAddToCartState(picker);
      }, true);

      document.addEventListener('variant:update', function() {
        document.querySelectorAll('variant-picker').forEach(function(picker) {
          if (!getImprintSizeSelect(picker)) return;

          syncImprintPickerState(picker);
        });

        refreshImprintAddToCartButtons();
      });

      ['pointerdown', 'mousedown', 'touchstart', 'click'].forEach(function(eventName) {
        document.addEventListener(eventName, function(event) {
          var button = event.target.closest('button[type="submit"], [name="add"], [data-add-to-cart], .product-form__submit');
          var form;
          var scope;
          var picker;

          if (!button) return;

          form = button.form || button.closest('form');
          if (!form || String(form.getAttribute('action') || '').indexOf('/cart/add') === -1) return;

          scope = form.closest('section, .shopify-section, [data-section-id], product-info, .product') || document;
          picker = scope.querySelector('variant-picker');

          if (picker) {
            if (isImprintAddToCartBlocked(picker)) {
              event.preventDefault();
              event.stopPropagation();

              if (eventName === 'click') {
                notifyImprintSizeRequired(picker);
              }

              return;
            }

            updateSelectedVariantIdForCart(picker);
          }

          syncDiameterInputsInScope(scope);
        }, true);
      });

      document.addEventListener('submit', function(event) {
        var form = event.target;
        var scope;
        var picker;

        if (!form || !form.matches('form[action*="/cart/add"]')) return;

        scope = form.closest('section, .shopify-section, [data-section-id], product-info, .product') || document;
        picker = scope.querySelector('variant-picker');

        if (picker && isImprintAddToCartBlocked(picker)) {
          event.preventDefault();
          event.stopPropagation();
          notifyImprintSizeRequired(picker);
          return;
        }

        if (picker) {
          updateSelectedVariantIdForCart(picker);
        }

        syncDiameterInputsInScope(scope);
      }, true);

      if (window.MutationObserver) {
        var imprintCartButtonObserverTimer;

        new MutationObserver(function() {
          window.clearTimeout(imprintCartButtonObserverTimer);
          imprintCartButtonObserverTimer = window.setTimeout(function() {
            document.querySelectorAll('variant-picker').forEach(function(picker) {
              if (picker.dataset.customCartVariantFixReady !== 'true') {
                prepareVariantPicker(picker);
              }
            });
            refreshImprintAddToCartButtons();
          }, 0);
        }).observe(document.documentElement, {
          childList: true,
          subtree: true
        });
      }
    }
  </script>
