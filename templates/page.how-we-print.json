        "custom_liquid_tLUXzj": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign safe_warning_text = section.settings.safe_area_warning | strip -%}\n      {%- if safe_warning_text == blank -%}\n        {%- assign safe_warning_text = \"Important Design Note: The area near the elastic edge remains unprinted. Click here to see an example.\" -%}\n        {%- assign safe_warning_text2 = \"Important Design Note: The area near the elastic edge remains unprinted.\" -%}\n      {%- endif -%}\n          {%- assign safe_banner_text = safe_warning_text -%}\n          {%- assign safe_banner_text2 = safe_warning_text2 -%}\n\n\n\n         {% assign safe_modal_id = 'custom-cover-safe-modal-' | append: section.id %}\n\n<!-- CLICKABLE SAFE BANNER -->\n<button\n  type=\"button\"\n  class=\"custom-cover-customizer__safe-banner\"\n  data-safe-modal-open=\"{{ safe_modal_id }}\"\n  aria-haspopup=\"dialog\"\n  aria-controls=\"{{ safe_modal_id }}\"\n>\n  <span\n    class=\"custom-cover-customizer__safe-banner-icon\"\n    aria-hidden=\"true\"\n  >\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width=\"18\"\n      height=\"18\"\n      viewBox=\"0 0 18 18\"\n      fill=\"none\"\n    >\n      <path\n        d=\"M9 16.5C13.1421 16.5 16.5 13.1421 16.5 9C16.5 4.85786 13.1421 1.5 9 1.5C4.85786 1.5 1.5 4.85786 1.5 9C1.5 13.1421 4.85786 16.5 9 16.5Z\"\n        stroke=\"currentColor\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      />\n      <path\n        d=\"M9 6V9\"\n        stroke=\"currentColor\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      />\n      <path\n        d=\"M9 12H9.0075\"\n        stroke=\"currentColor\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n      />\n    </svg>\n  </span>\n\n  <span class=\"custom-cover-customizer__safe-banner-text\">\n    {{ safe_banner_text | escape }}\n  </span>\n</button>\n\n<!-- SAFE AREA MODAL -->\n<div\n  id=\"{{ safe_modal_id }}\"\n  class=\"custom-cover-safe-modal\"\n  aria-hidden=\"true\"\n  data-safe-modal\n>\n  <div\n    class=\"custom-cover-safe-modal__overlay\"\n    aria-hidden=\"true\"\n    data-safe-modal-close\n  ></div>\n\n  <div\n    class=\"custom-cover-safe-modal__dialog\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-labelledby=\"{{ safe_modal_id }}-title\"\n    aria-describedby=\"{{ safe_modal_id }}-description\"\n    tabindex=\"-1\"\n    data-safe-modal-dialog\n  >\n    <!-- MODAL HEADER -->\n    <div class=\"custom-cover-safe-modal__header\">\n      <div class=\"custom-cover-safe-modal__heading\">\n        <span\n          class=\"custom-cover-safe-modal__notice-icon\"\n          aria-hidden=\"true\"\n        >\n          <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            width=\"18\"\n            height=\"18\"\n            viewBox=\"0 0 18 18\"\n            fill=\"none\"\n          >\n            <path\n              d=\"M9 16.5C13.1421 16.5 16.5 13.1421 16.5 9C16.5 4.85786 13.1421 1.5 9 1.5C4.85786 1.5 1.5 4.85786 1.5 9C1.5 13.1421 4.85786 16.5 9 16.5Z\"\n              stroke=\"currentColor\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n            <path\n              d=\"M9 6V9\"\n              stroke=\"currentColor\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n            <path\n              d=\"M9 12H9.0075\"\n              stroke=\"currentColor\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n            />\n          </svg>\n        </span>\n\n        <div class=\"custom-cover-safe-modal__heading-text\">\n          <h2\n            id=\"{{ safe_modal_id }}-title\"\n            class=\"custom-cover-safe-modal__title\"\n          >\n            Important Notice\n          </h2>\n\n          <p\n            id=\"{{ safe_modal_id }}-description\"\n            class=\"custom-cover-safe-modal__description\"\n          >\n            {{ safe_banner_text2 | escape }}\n          </p>\n        </div>\n      </div>\n\n      <button\n        type=\"button\"\n        class=\"custom-cover-safe-modal__close\"\n        aria-label=\"Close important notice\"\n        data-safe-modal-close\n      >\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"22\"\n          height=\"22\"\n          viewBox=\"0 0 22 22\"\n          fill=\"none\"\n          aria-hidden=\"true\"\n        >\n          <path\n            d=\"M5 5L17 17M17 5L5 17\"\n            stroke=\"currentColor\"\n            stroke-width=\"1.5\"\n            stroke-linecap=\"round\"\n          />\n        </svg>\n      </button>\n    </div>\n\n    <!-- FRONT AND BACK IMAGES -->\n    <div class=\"custom-cover-safe-modal__images\">\n      <div class=\"custom-cover-safe-modal__image-item\">\n        <div class=\"custom-cover-safe-modal__image-label\">\n          <span\n            class=\"custom-cover-safe-modal__image-label-dot\"\n            aria-hidden=\"true\"\n          ></span>\n\n          <span>Front</span>\n        </div>\n\n        <div class=\"custom-cover-safe-modal__image-wrapper\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0621/6784/2913/files/unnamed.jpg?v=1782537280\"\n            alt=\"Front printing area\"\n            class=\"custom-cover-safe-modal__image\"\n            width=\"1000\"\n            height=\"1000\"\n            loading=\"lazy\"\n          >\n        </div>\n      </div>\n\n      <div class=\"custom-cover-safe-modal__image-item\">\n        <div class=\"custom-cover-safe-modal__image-label\">\n          <span\n            class=\"custom-cover-safe-modal__image-label-dot\"\n            aria-hidden=\"true\"\n          ></span>\n\n          <span>Back</span>\n        </div>\n\n        <div class=\"custom-cover-safe-modal__image-wrapper\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0621/6784/2913/files/unnamed_1.jpg?v=1782537278\"\n            alt=\"Back printing area\"\n            class=\"custom-cover-safe-modal__image\"\n            width=\"1000\"\n            height=\"1000\"\n            loading=\"lazy\"\n          >\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .custom-cover-customizer__safe-banner {\n    display: inline-flex;\n    align-items: center;\n    align-self: flex-start;\n    gap: 8px;\n    width: auto !important;\n    max-width: 100%;\n    margin: 0 0 12px;\n    padding: 0 !important;\n    border: 0;\n    border-radius: 0;\n    background: transparent;\n    color: #da0004;\n    font-family: inherit;\n    font-size: var(--font-size--sm);\n    font-weight: inherit;\n    line-height: 1.3;\n    text-align: left;\n    box-shadow: none;\n    cursor: pointer;\n    appearance: none;\n    -webkit-appearance: none;\n}\n\n  .custom-cover-customizer__safe-banner-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n  }\n\n  .custom-cover-customizer__safe-banner-text {\n    text-decoration: underline;\n    text-decoration-thickness: 1px;\n    text-underline-offset: 3px;\n  }\n\n  .custom-cover-customizer__safe-banner:hover {\n    color: #b80003;\n    background: transparent;\n  }\n\n  \n\n  .custom-cover-customizer__safe-banner:focus-visible {\n    outline: 2px solid #da0004;\n    outline-offset: 3px;\n  }\n\n  .custom-cover-safe-modal {\n    position: fixed !important;\n    inset: 0 !important;\n    z-index: 2147483647 !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 100vw !important;\n    height: 100vh !important;\n    height: 100dvh !important;\n    max-width: none !important;\n    max-height: none !important;\n    margin: 0 !important;\n    padding: 24px !important;\n    overflow: hidden !important;\n    border: 0 !important;\n    border-radius: 0 !important;\n    visibility: hidden;\n    opacity: 0;\n    pointer-events: none;\n    box-sizing: border-box !important;\n    transition:\n      opacity 0.2s ease,\n      visibility 0.2s ease;\n  }\n\n  .custom-cover-safe-modal.is-open {\n    visibility: visible;\n    opacity: 1;\n    pointer-events: auto;\n  }\n\n  .custom-cover-safe-modal__overlay {\n    position: fixed !important;\n    inset: 0 !important;\n    z-index: 0 !important;\n    display: block !important;\n    width: 100vw !important;\n    height: 100vh !important;\n    height: 100dvh !important;\n    max-width: none !important;\n    max-height: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    border: 0 !important;\n    border-radius: 0 !important;\n    background: rgba(15, 15, 15, 0.68) !important;\n    cursor: pointer;\n    box-sizing: border-box !important;\n    backdrop-filter: blur(7px);\n    -webkit-backdrop-filter: blur(7px);\n  }\n\n  .custom-cover-safe-modal__dialog {\n    position: relative !important;\n    z-index: 1 !important;\n    display: block !important;\n    width: min(100%, 720px) !important;\n    max-width: 720px !important;\n    max-height: calc(100dvh - 48px) !important;\n    margin: 0 !important;\n    padding: 26px !important;\n    overflow-x: hidden !important;\n    overflow-y: auto !important;\n    border: 1px solid rgba(0, 0, 0, 0.06) !important;\n    border-radius: 20px !important;\n    background: #ffffff !important;\n    box-sizing: border-box !important;\n    box-shadow:\n      0 30px 80px rgba(0, 0, 0, 0.3),\n      0 8px 24px rgba(0, 0, 0, 0.14) !important;\n    transform: translateY(14px) scale(0.985);\n    transition: transform 0.2s ease;\n  }\n\n  .custom-cover-safe-modal.is-open\n    .custom-cover-safe-modal__dialog {\n    transform: translateY(0) scale(1);\n  }\n\n  .custom-cover-safe-modal__header {\n    display: grid !important;\n    grid-template-columns: minmax(0, 1fr) auto !important;\n    align-items: start !important;\n    gap: 20px !important;\n    width: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    margin: 0 0 24px !important;\n    padding: 0 !important;\n    box-sizing: border-box !important;\n  }\n\n  .custom-cover-safe-modal__heading {\n    display: flex !important;\n    align-items: flex-start !important;\n    gap: 12px !important;\n    width: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .custom-cover-safe-modal__notice-icon {\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    flex: 0 0 auto !important;\n    width: 38px !important;\n    height: 38px !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    border-radius: 50% !important;\n    background: rgba(218, 0, 4, 0.08) !important;\n    color: #da0004 !important;\n  }\n\n  .custom-cover-safe-modal__heading-text {\n    display: block !important;\n    flex: 1 1 auto !important;\n    width: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .custom-cover-safe-modal__title {\n    display: block !important;\n    width: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    color: #171717 !important;\n    font-family: inherit !important;\n    font-size: 22px !important;\n    font-style: normal !important;\n    font-weight: 700 !important;\n    line-height: 1.25 !important;\n    letter-spacing: -0.02em !important;\n    text-align: left !important;\n    white-space: normal !important;\n    word-break: normal !important;\n    overflow-wrap: normal !important;\n  }\n\n  .custom-cover-safe-modal__description {\n    display: block !important;\n    width: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    margin: 6px 0 0 !important;\n    padding: 0 !important;\n    color: #666666 !important;\n    font-family: inherit !important;\n    font-size: 14px !important;\n    font-style: normal !important;\n    font-weight: 400 !important;\n    line-height: 1.5 !important;\n    letter-spacing: normal !important;\n    text-align: left !important;\n    white-space: normal !important;\n    word-break: normal !important;\n    overflow-wrap: break-word !important;\n  }\n\n  .custom-cover-safe-modal__close {\n    position: static !important;\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    flex: 0 0 auto !important;\n    width: 38px !important;\n    height: 38px !important;\n    min-width: 38px !important;\n    min-height: 38px !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    border: 0 !important;\n    border-radius: 50% !important;\n    background: transparent !important;\n    color: #202020 !important;\n    box-shadow: none !important;\n    cursor: pointer;\n    appearance: none;\n    -webkit-appearance: none;\n    transition:\n      background 0.18s ease,\n      transform 0.18s ease;\n  }\n\n  .custom-cover-safe-modal__close:hover {\n    background: #f2f2f2 !important;\n    transform: rotate(5deg);\n  }\n\n  .custom-cover-safe-modal__close:focus-visible {\n    outline: 2px solid #da0004;\n    outline-offset: 2px;\n  }\n\n  .custom-cover-safe-modal__images {\n    display: grid !important;\n    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;\n    gap: 16px !important;\n    width: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .custom-cover-safe-modal__image-item {\n    display: block !important;\n    width: 100% !important;\n    min-width: 0 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n\n  .custom-cover-safe-modal__image-label {\n    display: flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n    width: 100% !important;\n    min-width: 0 !important;\n    margin: 0 0 10px !important;\n    padding: 0 4px !important;\n    color: #202020 !important;\n    font-family: inherit !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n    line-height: 1.3 !important;\n    text-align: left !important;\n  }\n\n  .custom-cover-safe-modal__image-label-dot {\n    display: block !important;\n    flex: 0 0 auto !important;\n    width: 8px !important;\n    height: 8px !important;\n    border-radius: 50% !important;\n    background: #da0004 !important;\n  }\n\n  .custom-cover-safe-modal__image-wrapper {\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 100% !important;\n    aspect-ratio: 1 / 1 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    overflow: hidden !important;\n    border: 0 !important;\n    border-radius: 12px !important;\n    background: #f1f1f1 !important;\n    box-sizing: border-box !important;\n  }\n\n  .custom-cover-safe-modal__image {\n    display: block !important;\n    width: 100% !important;\n    height: 100% !important;\n    min-width: 0 !important;\n    max-width: none !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    border: 0 !important;\n    border-radius: 0 !important;\n    object-fit: cover !important;\n  }\n\n  html.custom-cover-safe-modal-open,\n  body.custom-cover-safe-modal-open {\n    overflow: hidden !important;\n    overscroll-behavior: none !important;\n  }\n\n  @media screen and (max-width: 749px) {\n    .custom-cover-safe-modal {\n      padding: 16px !important;\n    }\n\n    .custom-cover-safe-modal__dialog {\n      width: 100% !important;\n      max-width: 100% !important;\n      max-height: calc(100dvh - 32px) !important;\n      padding: 20px !important;\n      border-radius: 17px !important;\n    }\n\n    .custom-cover-safe-modal__header {\n      gap: 12px !important;\n      margin-bottom: 20px !important;\n    }\n\n    .custom-cover-safe-modal__heading {\n      gap: 10px !important;\n    }\n\n    .custom-cover-safe-modal__notice-icon {\n      width: 34px !important;\n      height: 34px !important;\n    }\n\n    .custom-cover-safe-modal__title {\n      font-size: 20px !important;\n    }\n\n    .custom-cover-safe-modal__description {\n      margin-top: 4px !important;\n      font-size: 13px !important;\n    }\n\n    .custom-cover-safe-modal__close {\n      width: 34px !important;\n      height: 34px !important;\n      min-width: 34px !important;\n      min-height: 34px !important;\n    }\n\n    .custom-cover-safe-modal__images {\n      gap: 12px !important;\n    }\n\n    .custom-cover-safe-modal__image-label {\n      margin-bottom: 8px !important;\n      font-size: 13px !important;\n    }\n\n    .custom-cover-safe-modal__image-wrapper {\n      border-radius: 10px !important;\n    }\n  }\n\n  @media screen and (max-width: 520px) {\n    .custom-cover-safe-modal__images {\n      grid-template-columns: 1fr !important;\n      gap: 18px !important;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .custom-cover-safe-modal,\n    .custom-cover-safe-modal__dialog,\n    .custom-cover-safe-modal__close {\n      transition: none !important;\n    }\n  }\n</style>\n\n<script>\n  (() => {\n    const modalId = '{{ safe_modal_id }}';\n    const modal = document.getElementById(modalId);\n\n    if (!modal || modal.dataset.initialized === 'true') {\n      return;\n    }\n\n    modal.dataset.initialized = 'true';\n\n    /*\n     * Move the modal directly inside the body.\n     * This stops Shopify section borders, rounded corners,\n     * transforms and overflow hidden from clipping the overlay.\n     */\n    if (modal.parentElement !== document.body) {\n      document.body.appendChild(modal);\n    }\n\n    const dialog = modal.querySelector(\n      '[data-safe-modal-dialog]'\n    );\n\n    const openButtons = document.querySelectorAll(\n      `[data-safe-modal-open=\"${modalId}\"]`\n    );\n\n    const closeButtons = modal.querySelectorAll(\n      '[data-safe-modal-close]'\n    );\n\n    let previouslyFocusedElement = null;\n\n    const getFocusableElements = () => {\n      return Array.from(\n        modal.querySelectorAll(\n          'button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n        )\n      );\n    };\n\n    const openModal = () => {\n      previouslyFocusedElement = document.activeElement;\n\n      modal.classList.add('is-open');\n      modal.setAttribute('aria-hidden', 'false');\n\n      document.documentElement.classList.add(\n        'custom-cover-safe-modal-open'\n      );\n\n      document.body.classList.add(\n        'custom-cover-safe-modal-open'\n      );\n\n      requestAnimationFrame(() => {\n        dialog?.focus();\n      });\n    };\n\n    const closeModal = () => {\n      modal.classList.remove('is-open');\n      modal.setAttribute('aria-hidden', 'true');\n\n      document.documentElement.classList.remove(\n        'custom-cover-safe-modal-open'\n      );\n\n      document.body.classList.remove(\n        'custom-cover-safe-modal-open'\n      );\n\n      if (\n        previouslyFocusedElement &&\n        typeof previouslyFocusedElement.focus === 'function'\n      ) {\n        previouslyFocusedElement.focus();\n      }\n    };\n\n    openButtons.forEach((button) => {\n      button.addEventListener('click', openModal);\n    });\n\n    closeButtons.forEach((button) => {\n      button.addEventListener('click', closeModal);\n    });\n\n    modal.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape') {\n        closeModal();\n        return;\n      }\n\n      if (event.key !== 'Tab') {\n        return;\n      }\n\n      const focusableElements = getFocusableElements();\n\n      if (!focusableElements.length) {\n        event.preventDefault();\n        dialog?.focus();\n        return;\n      }\n\n      const firstElement = focusableElements[0];\n      const lastElement =\n        focusableElements[focusableElements.length - 1];\n\n      if (\n        event.shiftKey &&\n        document.activeElement === firstElement\n      ) {\n        event.preventDefault();\n        lastElement.focus();\n      } else if (\n        !event.shiftKey &&\n        document.activeElement === lastElement\n      ) {\n        event.preventDefault();\n        firstElement.focus();\n      }\n    });\n  })();\n</script>"
